# =============================================================
# NOTUSLAB LIMS - VARIÁVEIS DE AMBIENTE DE EXEMPLO
# Copie este arquivo para .env na raiz antes de iniciar o sistema
# =============================================================

# Conexão com o Banco de Dados PostgreSQL (Docker Compose)
DATABASE_URL="postgresql://admin:admin@localhost:5432/notuslab_lims?schema=public"

# Parâmetros do Docker Compose (postgres)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=notuslab_lims
POSTGRES_PORT=5432

# Configurações do Servidor Backend
PORT=3333
NODE_ENV=development
